# 真测 Realcast 生产环境变量示例
# 复制为 .env 后修改下方值（.env 已被 .gitignore 忽略，不会入库）

# 管理后台令牌（运营建市场 / 评论审核 / Oracle 结算 必须带 x-admin-token 头）
ADMIN_TOKEN=change-me-to-a-long-random-string

# 允许的前端跨域来源（逗号分隔；生产务必改成你的域名，不要留 *）
CORS_ORIGINS=https://your-domain.example.com

# SQLite 持久化路径（容器内，已挂卷到 ./data）
DB_PATH=/data/platform.db

# uvicorn worker 数。
# 默认必须为 1：未配 REDIS_URL 时广播走进程内 MemoryBackplane，多 worker 会让
# 连在不同进程的用户看到不一致的概率。要 >1 请先配 REDIS_URL。
UVICORN_WORKERS=1

# 可选：Redis 广播背板。配了它（且装了 redis 包）才能安全地把 worker 调到 >1。
# REDIS_URL=redis://:password@host:6379/0

# 业务时区（相对 UTC 的小时偏移，支持小数如 5.5），决定「今天是哪一天」。
# 缺省 0=UTC；面向国内用户设 8。库内时间一律存 UTC，展示层再换算。
APP_TZ=8

# 首次启动自动播种演示数据（1=开）。仅演示/联调环境开，正式运营必须关。
SEED_ON_BOOT=0
