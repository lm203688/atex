# 真测 Realcast 生产环境变量示例
# 复制为 .env 后修改下方值（.env 已被 .gitignore 忽略，不会入库）

# 管理后台令牌（运营建市场 / 评论审核 / Oracle 结算 必须带 x-admin-token 头）
ADMIN_TOKEN=change-me-to-a-long-random-string

# 允许的前端跨域来源（逗号分隔；生产务必改成你的域名，不要留 *）
CORS_ORIGINS=https://your-domain.example.com

# SQLite 持久化路径（容器内，已挂卷到 ./data）
DB_PATH=/data/platform.db

# uvicorn worker 数（CPU 核数相关，2 核机器给 2）
UVICORN_WORKERS=2
