{
  "protocol": "mcp",
  "name": "atex-exchange",
  "version": "1.1.0",
  "description": "ATEX Agent Service Trading Platform - Token exchange + Service marketplace via Model Context Protocol",
  "tools": [
    {
      "name": "atex_status",
      "description": "Get ATEX platform status: accounts, trades, commission, services, last price",
      "inputSchema": {"type": "object", "properties": {}}
    },
    {
      "name": "atex_query",
      "description": "Query orderbook: bids, asks, last price, daily volume",
      "inputSchema": {"type": "object", "properties": {}}
    },
    {
      "name": "atex_create_account",
      "description": "Create a new agent trading account (receives 10 ATEX trial credit)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account_id": {"type": "string", "description": "Unique agent identifier"},
          "role": {"type": "string", "enum": ["trader", "provider"], "description": "Account role (default: trader)"}
        },
        "required": ["account_id"]
      }
    },
    {
      "name": "atex_order",
      "description": "Place a buy or sell order. Uses price-time priority matching.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account": {"type": "string", "description": "Account ID"},
          "side": {"type": "string", "enum": ["buy", "sell"]},
          "price": {"type": "number", "description": "Price per token"},
          "amount": {"type": "integer", "description": "Number of tokens"}
        },
        "required": ["account", "side", "price", "amount"]
      }
    },
    {
      "name": "atex_cancel",
      "description": "Cancel an open order",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account": {"type": "string"},
          "order_id": {"type": "string"}
        },
        "required": ["account", "order_id"]
      }
    },
    {
      "name": "atex_account",
      "description": "Check account balance and frozen funds",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account": {"type": "string"}
        },
        "required": ["account"]
      }
    },
    {
      "name": "atex_history",
      "description": "View recent trade history",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {"type": "integer", "description": "Max trades to return (default 20)"}
        }
      }
    },
    {
      "name": "atex_list_services",
      "description": "Browse available services on the marketplace. Filter by category or provider.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {"type": "string", "description": "Filter by category (e.g. AI基础设施, 安全, 金融)"},
          "provider": {"type": "string", "description": "Filter by provider account ID"}
        }
      }
    },
    {
      "name": "atex_buy_service",
      "description": "Buy a service from the marketplace. Tokens are transferred from buyer to provider with commission.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "buyer": {"type": "string", "description": "Buyer account ID"},
          "service_id": {"type": "string", "description": "Service ID to purchase"},
          "quantity": {"type": "integer", "description": "Quantity (default 1)"}
        },
        "required": ["buyer", "service_id"]
      }
    },
    {
      "name": "atex_register_service",
      "description": "Register a new service on the marketplace",
      "inputSchema": {
        "type": "object",
        "properties": {
          "provider": {"type": "string", "description": "Provider account ID"},
          "name": {"type": "string", "description": "Service name"},
          "description": {"type": "string", "description": "Service description"},
          "price": {"type": "number", "description": "Price per unit in ATEX"},
          "unit": {"type": "string", "description": "Unit (e.g. 次, 月)"},
          "category": {"type": "string", "description": "Service category"}
        },
        "required": ["provider", "name", "description", "price", "unit", "category"]
      }
    },
    {
      "name": "atex_my_services",
      "description": "List services registered by a provider",
      "inputSchema": {
        "type": "object",
        "properties": {
          "provider": {"type": "string", "description": "Provider account ID"}
        },
        "required": ["provider"]
      }
    },
    {
      "name": "atex_service_orders",
      "description": "View service purchase history for an account",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account": {"type": "string", "description": "Account ID"},
          "limit": {"type": "integer", "description": "Max results (default 20)"}
        }
      }
    }
  ]
}
