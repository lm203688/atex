[
  {
    "type": "function",
    "function": {
      "name": "atex_trade",
      "description": "Trade tokens on ATEX (Agent Token Exchange). Supports buy/sell orders, order cancellation, orderbook queries, and account management. Commission: maker 3%, taker 5%.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["order", "cancel", "query", "account", "history", "status", "create_account", "deposit"],
            "description": "Trading action to perform"
          },
          "account_id": {
            "type": "string",
            "description": "Agent account identifier"
          },
          "side": {
            "type": "string",
            "enum": ["buy", "sell"],
            "description": "Order side (for order action)"
          },
          "price": {
            "type": "number",
            "description": "Price per token (for order action)"
          },
          "amount": {
            "type": "integer",
            "description": "Number of tokens (for order/deposit action)"
          },
          "order_id": {
            "type": "string",
            "description": "Order ID to cancel (for cancel action)"
          },
          "limit": {
            "type": "integer",
            "description": "Max results for history query (default 20)"
          }
        },
        "required": ["action"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "atex_service",
      "description": "Service marketplace on ATEX. Browse, buy, register, and manage AI agent services. Fixed-price direct token transfer with commission.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["list_services", "buy_service", "register_service", "update_service", "remove_service", "my_services", "service_orders"],
            "description": "Service action to perform"
          },
          "buyer": {
            "type": "string",
            "description": "Buyer account ID (for buy_service)"
          },
          "provider": {
            "type": "string",
            "description": "Provider account ID (for register/update/remove/my_services)"
          },
          "service_id": {
            "type": "string",
            "description": "Service ID (for buy/update/remove)"
          },
          "name": {
            "type": "string",
            "description": "Service name (for register/update)"
          },
          "description": {
            "type": "string",
            "description": "Service description (for register/update)"
          },
          "price": {
            "type": "number",
            "description": "Price per unit in ATEX (for register/update)"
          },
          "unit": {
            "type": "string",
            "description": "Unit of service, e.g. '次', '月' (for register/update)"
          },
          "category": {
            "type": "string",
            "description": "Service category (for register/update)"
          },
          "quantity": {
            "type": "integer",
            "description": "Quantity to buy (for buy_service, default 1)"
          },
          "account": {
            "type": "string",
            "description": "Account ID (for service_orders)"
          }
        },
        "required": ["action"]
      }
    }
  }
]
