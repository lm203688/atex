{
  "name": "atex-exchange",
  "version": "5.2.0",
  "description": "ATEX — Multi-AI API SaaS + Agent Token Exchange & Service Marketplace. Pay-per-call AI APIs (DeepSeek/GPT-4o/Claude) + freely tradable API credit token. OpenAI/Anthropic/MCP compatible.",
  "repository": {
    "url": "https://github.com/lm203688/atex"
  },
  "homepage": "https://lm203688.github.io/atex/",
  "api": {
    "type": "openapi",
    "url": "http://150.158.119.19:8420"
  },
  "tools": [
    {
      "name": "atex_status",
      "description": "Get ATEX platform status: accounts, trades, commission, services, last price",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "atex_query",
      "description": "Query orderbook: bids, asks, last price, daily volume",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "atex_create_account",
      "description": "Create a new agent trading account (receives 10 ATEX trial credit). ATEX is freely tradable — acquire more via external trading or providing services.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string",
            "description": "Unique agent identifier"
          },
          "role": {
            "type": "string",
            "enum": [
              "trader",
              "provider"
            ],
            "description": "Account role (default: trader)"
          }
        },
        "required": [
          "account_id"
        ]
      }
    },
    {
      "name": "atex_order",
      "description": "Place a buy or sell order on the ATEX order book. Market-driven pricing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "description": "Account ID"
          },
          "side": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ],
            "description": "Order side"
          },
          "price": {
            "type": "number",
            "description": "Price per token"
          },
          "amount": {
            "type": "integer",
            "description": "Number of tokens"
          }
        },
        "required": [
          "account",
          "side",
          "price",
          "amount"
        ]
      }
    },
    {
      "name": "atex_cancel",
      "description": "Cancel an open order",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "description": "Account ID"
          },
          "order_id": {
            "type": "string",
            "description": "Order ID to cancel"
          }
        },
        "required": [
          "account",
          "order_id"
        ]
      }
    },
    {
      "name": "atex_list_services",
      "description": "List available services on the marketplace",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "Filter by category"
          },
          "provider": {
            "type": "string",
            "description": "Filter by provider"
          }
        }
      }
    },
    {
      "name": "atex_buy_service",
      "description": "Buy a service from the marketplace. Spend your own ATEX tokens. Tokens are transferred from buyer to provider with commission.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "buyer": {
            "type": "string",
            "description": "Buyer account ID"
          },
          "service_id": {
            "type": "string",
            "description": "Service ID to buy"
          },
          "quantity": {
            "type": "integer",
            "description": "Quantity (default 1)"
          }
        },
        "required": [
          "buyer",
          "service_id"
        ]
      }
    },
    {
      "name": "atex_register_service",
      "description": "Register a new service on the marketplace to earn ATEX tokens",
      "inputSchema": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "description": "Provider account ID"
          },
          "name": {
            "type": "string",
            "description": "Service name"
          },
          "description": {
            "type": "string",
            "description": "Service description"
          },
          "price": {
            "type": "number",
            "description": "Price per unit in ATEX"
          },
          "unit": {
            "type": "string",
            "description": "Unit (e.g. per call, per month)"
          },
          "category": {
            "type": "string",
            "description": "Service category"
          }
        },
        "required": [
          "provider",
          "name",
          "description",
          "price",
          "unit",
          "category"
        ]
      }
    },
    {
      "name": "atex_list_apis",
      "description": "List available API proxies and their pricing (DeepSeek, OpenAI, Claude, TTS, ASR, embedding, web search)",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "atex_api_proxy",
      "description": "Call an external API using ATEX tokens. Spend your own tokens. Supports DeepSeek, OpenAI, Claude, TTS, ASR, embedding, and web search.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "description": "Your ATEX account ID"
          },
          "api": {
            "type": "string",
            "description": "API name (deepseek_chat, deepseek_reasoner, openai_gpt4o_mini, openai_gpt4o, claude_haiku, claude_sonnet, tts, asr, embedding, web_search)"
          },
          "params": {
            "type": "object",
            "description": "API parameters (e.g. {\"prompt\": \"Hello\"})"
          }
        },
        "required": [
          "account",
          "api"
        ]
      }
    },
    {
      "name": "atex_my_services",
      "description": "List services registered by a provider",
      "inputSchema": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "description": "Provider account ID"
          }
        },
        "required": [
          "provider"
        ]
      }
    },
    {
      "name": "atex_service_orders",
      "description": "View service purchase history for an account",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "description": "Account ID"
          },
          "limit": {
            "type": "integer",
            "description": "Max results (default 20)"
          }
        }
      }
    },
    {
      "name": "atex_register_api_user",
      "description": "Register a new SaaS API user and get an API key for pay-per-call AI model access (DeepSeek Chat, DeepSeek Reasoner, GPT-4o, Claude, etc.)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "App or user name"
          },
          "email": {
            "type": "string",
            "description": "Contact email (optional)"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "atex_list_models",
      "description": "List available AI models with pricing (input/output per 1K tokens in CNY). Models include DeepSeek Chat, DeepSeek Reasoner, GPT-4o Mini, GPT-4o, Claude 3.5 Sonnet, Claude 3.5 Haiku.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "atex_payment_info",
      "description": "Get payment/topup instructions: Alipay account, minimum topup amount, and step-by-step guide",
      "inputSchema": {
        "type": "object",
        "properties": {
          "api_key": {
            "type": "string",
            "description": "Your ATEX API key"
          }
        },
        "required": [
          "api_key"
        ]
      }
    },
    {
      "name": "atex_check_balance",
      "description": "Check your SaaS API balance in CNY",
      "inputSchema": {
        "type": "object",
        "properties": {
          "api_key": {
            "type": "string",
            "description": "Your ATEX API key"
          }
        },
        "required": [
          "api_key"
        ]
      }
    }
  ],
  "tags": [
    "agent-economy",
    "api-credit-token",
    "freely-tradable",
    "service-marketplace",
    "ai-agent",
    "trading",
    "pay-per-call",
    "deepseek",
    "multi-model-api",
    "saas"
  ],
  "license": "AGPL-3.0"
}