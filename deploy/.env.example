# 真测 Realcast 生产环境变量（复制为 .env 并填值；切勿提交真实 .env 到仓库）
# 用法：docker compose 通过 env_file 注入；systemd 通过 EnvironmentFile 注入

# 管理员令牌：运营后台 / 内容审核 / 市场创建用。务必改为长随机串（>=32 位）。
ADMIN_TOKEN=change-me-to-a-long-random-string-min-32-chars

# 允许的跨域来源（前端域名），逗号分隔。默认仅 localhost，生产必须改成你的域名。
CORS_ORIGINS=https://your-domain.example.com

# 数据库路径：容器内指向挂载卷（/data/platform.db）。宿主机裸跑时改为 /opt/realcast/data/platform.db
DB_PATH=/data/platform.db

# 请求体上限（字节），默认 1MB
MAX_BODY_BYTES=1048576

# uvicorn worker 数。
# 默认必须为 1：未配 REDIS_URL 时广播走进程内 MemoryBackplane，多 worker 会让
# 连在不同进程的用户看到不一致的概率。要 >1 请先配 REDIS_URL（见下方）。
UVICORN_WORKERS=1

# 可选：Redis 广播背板。配了它（且装了 redis 包）才能安全地把 worker 调到 >1，
# 因为多进程需要共享广播域。未配置时强制单 worker。
# REDIS_URL=redis://:password@host:6379/0

# 业务时区（相对 UTC 的小时偏移，支持小数如 5.5）。
# 决定「今天是哪一天」（每日任务、连续签到、按天统计的边界）。
# 缺省 0=UTC；面向国内用户设 8。库内时间一律存 UTC，展示层再换算。
APP_TZ=8

# 首次启动自动播种演示数据（1=开）。仅演示/联调环境开，正式运营必须关，
# 否则演示市场与演示用户会混进真实数据。幂等：库里已有用户则跳过。
SEED_ON_BOOT=0

# 可选：外部 Oracle HTTP 权威源（结算自动对接，需密钥/鉴权由实现侧处理）
ORACLE_HTTP_ENDPOINT=
